# ==============================================================================
# QuantDinger - Easypanel Environment Template
# ==============================================================================
# Copie e cole essas variáveis na aba "Environment" do seu serviço no Easypanel.
# Gere chaves seguras para SECRET_KEY e CREDENTIAL_ENCRYPTION_KEY.
# ==============================================================================

# Timezone do sistema (ex: America/Sao_Paulo ou UTC)
TZ=America/Sao_Paulo

# Credenciais do Administrador Inicial (use para fazer o primeiro login)
ADMIN_USER=admin
ADMIN_PASSWORD=TroqueEstaSenhaForte123!
ADMIN_EMAIL=admin@seudominio.com

# Chaves de Criptografia e Sessão (Obrigatório em produção)
# DICA: Gere strings aleatórias com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=gere_uma_chave_hex_de_32_bytes_aqui
CREDENTIAL_ENCRYPTION_KEY=gere_outra_chave_hex_de_32_bytes_aqui

# Banco de Dados PostgreSQL (gerenciado internamente no stack)
POSTGRES_DB=quantdinger
POSTGRES_USER=quantdinger
POSTGRES_PASSWORD=senha_segura_para_o_postgres_123

# URLs dos Frontends (Separados por vírgula para autorização CORS e OAuth)
# Substitua pelos seus domínios reais configurados no Easypanel
FRONTEND_URL=https://trader.seudominio.com,https://m.seudominio.com

# Proibir brokers locais em ambiente de nuvem
ALLOW_LOCAL_DESKTOP_BROKERS=false

# Configuração de IA / LLM (OpenRouter gratuito por padrão)
LLM_PROVIDER=openrouter
OPENROUTER_API_KEY=sk-or-v1-seu-token-openrouter-aqui
OPENROUTER_MODEL=nvidia/nemotron-3.5-lightning:free

# (Opcional) Outros provedores de LLM
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o

# (Opcional) Portas dos Frontends mapeadas no Host
FRONTEND_PORT=8888
MOBILE_PORT=8889
